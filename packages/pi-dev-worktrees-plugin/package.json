{
  "name": "@blackbelt-technology/pi-dev-worktrees-plugin",
  "version": "0.5.3",
  "description": "pi-worktrees integration plugin for pi-dashboard — adds session-card badge showing active worktree and devcontainer state",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/BlackBeltTechnology/pi-agent-dashboard",
    "directory": "packages/pi-dev-worktrees-plugin"
  },
  "exports": {
    ".": {
      "types": "./src/client/index.tsx",
      "default": "./src/client/index.tsx"
    },
    "./client": {
      "types": "./src/client/index.tsx",
      "default": "./src/client/index.tsx"
    }
  },
  "files": [
    "src/"
  ],
  "pi-dashboard-plugin": {
    "id": "pi-dev-worktrees",
    "displayName": "pi-dev-worktrees Workspace",
    "priority": 100,
    "client": "./src/client/index.tsx",
    "claims": [
      {
        "slot": "session-card-badge",
        "component": "PiDevWorktreesBadge",
        "predicate": "hasPiDevWorktrees"
      }
    ]
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@blackbelt-technology/pi-dashboard-shared": "^0.5.3"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
